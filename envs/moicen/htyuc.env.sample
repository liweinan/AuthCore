# AuthCore htyuc — 示例配置（可提交到开源仓库）。
# 部署：build_and_deploy_authcore.sh 会将其 scp 为远程 /mnt/huiwing/htyuc/.env；上线前请替换所有 REPLACE_* / YOUR_* 占位符。

UC_DB_URL=postgres://postgres:postgres@localhost:5432/htyuc_moicen
WS_DB_URL=postgres://postgres:postgres@localhost:5432/htyws_moicen
KC_DB_URL=postgres://postgres:postgres@localhost:5432/htykc_moicen
DATABASE_URL=postgres://postgres:postgres@localhost:5432/htyuc_moicen

ADMIN_DOMAIN=admin.moicen.com
EXPIRATION_DAYS=1
JWT_KEY=REPLACE_JWT_SIGNING_KEY_HEX_OR_BYTES
LOGGER_LEVEL=DEBUG
MUSIC_ROOM_MINI_DOMAIN=music-room.moicen.com
MUSIC_ROOM_MINI_URL=https://music-room.moicen.com
MUSIC_ROOM_WX_MINI_ID=REPLACE_WX_MINI_APPID
MUSIC_ROOM_WX_MINI_SECRET=REPLACE_WX_MINI_SECRET
POOL_SIZE=20
REDIS_HOST=localhost
REDIS_PORT=6379
SKIP_POST_LOGIN=false
SKIP_REGISTRATION=false
SKIP_WX_PUSH=false
TS_DOMAIN=ts.moicen.com
UC_PORT=3000
UC_URL=http://127.0.0.1:3000/api/v1/uc
UPYUN_OPERATOR=REPLACE_UPYUN_OPERATOR
UPYUN_PASSWORD=REPLACE_UPYUN_PASSWORD

WS_URL=http://127.0.0.1:3001/api/v1/ws
WS_PORT=3001

KC_URL=http://127.0.0.1:3002/api/v1/kc
KC_PORT=3002

WX_MSG_REJECT_REGISTER="REPLACE_WX_MSG_TEMPLATE_ID"
WX_MSG_STUDENT_REGISTER="REPLACE_WX_MSG_TEMPLATE_ID"
WX_MSG_STUDENT_REGISTER_SUCCESS="REPLACE_WX_MSG_TEMPLATE_ID"
WX_MSG_TEACHER_REGISTER="REPLACE_WX_MSG_TEMPLATE_ID"
WX_MSG_TEACHER_REGISTER_SUCCESS="REPLACE_WX_MSG_TEMPLATE_ID"

NGX_URL=https://admin.moicen.com/api/ngx

print_debug=true
